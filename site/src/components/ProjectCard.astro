---
import {
  ArrowUpRightIcon as ArrowUpRight,
  LinkIcon as Link,
} from '@phosphor-icons/react/ssr';
import WorkVisual from './WorkVisual.astro';
import { localeFromPath } from '../data/i18n';
import { projects } from '../data/site';
interface Props {
  project: (typeof projects)[number];
}
const { project } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const external = project.url.startsWith('http');
const domain = new URL(project.url, 'https://kevin1988.fun').hostname;
---

<a
  class="project-card"
  data-reveal
  href={project.url}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <WorkVisual id={project.id} locale={locale} />
  <div class="project-card-copy">
    <span class="eyebrow">{project.category}</span>
    <h3>{project.name}</h3>
    <span class="project-role">{project.role}</span>
    <p>{project.description}</p>
    <span class="project-link">
      <Link size={16} aria-hidden="true" />
      {domain}
      <ArrowUpRight size={14} aria-hidden="true" />
    </span>
  </div>
</a>
