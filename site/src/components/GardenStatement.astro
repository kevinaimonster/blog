---
import { ArrowUpRightIcon as ArrowUpRight } from '@phosphor-icons/react/ssr';
import { localizedPath, translator, type Locale } from '../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const lines =
  locale === 'en'
    ? ['A place for finished work.', 'And unfinished thoughts.']
    : ['留下已完成的作品，', '也留住未完成的想法。'];
---

<section class="garden-statement container" aria-labelledby="garden-statement">
  <span class="eyebrow">{t('持续生长', 'Always a work in progress')}</span>
  <h2 id="garden-statement" aria-label={lines.join(' ')}>
    {lines.map((line) => (
      <span class="statement-line" aria-hidden="true">
        {(locale === 'en' ? line.split(' ') : [line]).map((word, index) => (
          <span
            data-word
            style={`--word-delay: ${Math.min(index * 60, 360)}ms`}
          >
            {word}
            {locale === 'en' ? ' ' : ''}
          </span>
        ))}
      </span>
    ))}
  </h2>
  <a class="text-link" href={localizedPath('/about/', locale)}>
    {t('关于这个花园', 'A little more about me')}
    <ArrowUpRight size={18} />
  </a>
</section>
