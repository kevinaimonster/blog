---
import { getCollection } from 'astro:content';
import { Rss, BriefcaseBusiness, ArrowRight, Copy } from 'lucide-react';
import Base from '../layouts/Base.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import XIcon from '../components/XIcon.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import GardenFeed, { type FeedItem } from '../components/GardenFeed';
import { site, projects, thoughts, bookmarks, photos } from '../data/site';
const notes = await getCollection('notes', ({ data }) => !data.draft);
const items: FeedItem[] = [
  ...notes.map((note) => ({
    id: note.id,
    date: note.data.date,
    title: note.data.title,
    text: note.data.description,
    tag: note.data.tags[0],
    url: `/notes/${note.id}/`,
    kind: 'note' as const,
  })),
  ...thoughts.map((item) => ({
    ...item,
    title: '一条建站近况',
    kind: 'thought' as const,
  })),
  ...bookmarks.map((item) => ({
    ...item,
    text: item.description,
    tag: item.category,
    kind: 'bookmark' as const,
  })),
].sort((a, b) => b.date.localeCompare(a.date));
---

<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <a class="hero-avatar" href="/about/" aria-label="关于 Kevin">
      <img
        src={site.avatar}
        alt="Kevin 的头像，来自 kevin.top"
        width="64"
        height="64"
        fetchpriority="high"
      />
    </a>
    <div class="hero-copy">
      <h1 id="hero-title">
        {site.headline[0]}
        <br />
        {site.headline[1]}
      </h1>
      <p>{site.intro}</p>
      <div class="social-links">
        <a
          href={site.x}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Kevin 的 X"
        >
          <XIcon />
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Kevin 的 GitHub"
        >
          <GitHubIcon />
        </a>
      </div>
    </div>
  </section>
  <section
    class="photo-section"
    aria-label="图片带：原站插画与可替换的图库示意图"
  >
    <div class="photo-track">
      {photos.map((photo) => (
        <figure class="photo-frame">
          <img
            src={photo.src}
            alt={photo.alt}
            width="576"
            height="640"
            loading="eager"
          />
          <a
            href={photo.source}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`查看${photo.kind}来源：${photo.alt}`}
          >
            <span>
              {photo.kind} · {photo.credit}
            </span>
          </a>
        </figure>
      ))}
    </div>
  </section>
  <div class="journal-grid container">
    <section aria-label="笔记与近况" class="journal-main">
      <GardenFeed items={items} client:load />
    </section>
    <aside class="journal-aside">
      <section
        class="sidebar-card subscribe-card"
        aria-labelledby="subscribe-title"
      >
        <h2 id="subscribe-title">
          <Rss size={22} aria-hidden="true" />
          保持联系
        </h2>
        <p>通过 RSS 查看新笔记，按自己的节奏阅读。</p>
        <div class="rss-controls">
          <a href="/rss.xml" class="rss-address">
            Kevin 的笔记 · RSS
          </a>
          <button type="button" data-copy-rss aria-label="复制 RSS 订阅地址">
            <Copy size={15} aria-hidden="true" />
            复制
          </button>
        </div>
        <span class="copy-status" role="status" data-copy-status></span>
      </section>
      <section class="sidebar-card work-card" aria-labelledby="work-title">
        <h2 id="work-title">
          <BriefcaseBusiness size={22} aria-hidden="true" />
          作品与项目
        </h2>
        <ul>
          {projects
            .filter((project) => project.featured)
            .map((project) => (
              <li>
                <ProjectIcon icon={project.icon} size={21} />
                <div>
                  <a
                    href={project.url}
                    target={
                      project.url.startsWith('http') ? '_blank' : undefined
                    }
                    rel={
                      project.url.startsWith('http')
                        ? 'noopener noreferrer'
                        : undefined
                    }
                  >
                    {project.name}
                  </a>
                  <div class="project-meta">
                    <span>{project.role}</span>
                    <span>{project.category}</span>
                  </div>
                </div>
              </li>
            ))}
        </ul>
        <a class="subtle-button" href="/projects/">
          查看所有项目 <ArrowRight size={15} />
        </a>
      </section>
    </aside>
  </div>
  <script>
    const button = document.querySelector<HTMLButtonElement>('[data-copy-rss]');
    button?.addEventListener('click', async () => {
      const status = document.querySelector<HTMLElement>('[data-copy-status]');
      try {
        await navigator.clipboard.writeText(
          new URL('/rss.xml', location.origin).href,
        );
        if (status) status.textContent = '订阅地址已复制';
      } catch {
        if (status)
          status.textContent = '暂时无法复制，可以打开左侧 RSS 链接获取地址。';
      }
    });
  </script>
</Base>
