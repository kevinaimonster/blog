<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  if (!reducedMotion.matches && 'IntersectionObserver' in window) {
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.setAttribute('data-reveal-state', 'visible');
          reveal.unobserve(entry.target);
        }
      },
      { threshold: 0.08, rootMargin: '0px 0px -24px 0px' },
    );
    document
      .querySelectorAll<HTMLElement>('[data-reveal]')
      .forEach((element) => {
        if (element.getBoundingClientRect().top < innerHeight) return;
        element.dataset.revealState = 'pending';
        reveal.observe(element);
      });
    const words = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.setAttribute('data-word-state', 'visible');
          words.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.5 },
    );
    document.querySelectorAll<HTMLElement>('[data-word]').forEach((word) => {
      word.dataset.wordState = 'pending';
      words.observe(word);
    });
    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches) return;
      reveal.disconnect();
      words.disconnect();
      document
        .querySelectorAll('[data-reveal-state]')
        .forEach((element) =>
          element.setAttribute('data-reveal-state', 'visible'),
        );
      document
        .querySelectorAll('[data-word-state]')
        .forEach((element) =>
          element.setAttribute('data-word-state', 'visible'),
        );
    });
  }
</script>
