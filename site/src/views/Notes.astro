---
import { getNotes, notePath } from '../data/notes';
import { localeFromPath, localizedPath, translator } from '../data/i18n';
import { ArrowUpRightIcon, RssIcon } from '@phosphor-icons/react/ssr';
import Base from '../layouts/Base.astro';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
const notes = await getNotes(locale);
const years = [...new Set(notes.map((note) => note.data.date.slice(0, 4)))];
---

<Base
  title={t('文章', 'Writing')}
  description={t(
    'Kevin 的文章与手记：AI 产品、macOS 工具、技术决策和实践中的思考。',
    'Articles and field notes by Kevin on AI products, macOS tools, technical decisions, and work in progress.',
  )}
>
  <div class="container page-container">
    <header class="page-heading">
      <div class="eyebrow">{t('写作与记录', 'The writing archive')}</div>
      <h1>{t('把过程，写下来。', 'Notes along the way.')}</h1>
      <p>
        {t(
          '一些想明白的事，也有一些还在寻找答案的问题。',
          'Things I’ve figured out, and questions I’m still working through.',
        )}
      </p>
      <a class="text-link" href={href('/rss.xml')}>
        <RssIcon size={15} />
        {t('订阅文章', 'Subscribe via RSS')}
      </a>
    </header>
    {years.map((year) => (
      <section class="archive-layout" aria-label={year}>
        <div class="archive-year">
          {year}
          <span>
            {notes.filter((note) => note.data.date.startsWith(year)).length}{' '}
            {t('篇文章', 'written entries')}
          </span>
        </div>
        <div class="notes-list">
          {notes
            .filter((note) => note.data.date.startsWith(year))
            .map((note) => (
              <article>
                <time datetime={note.data.date}>
                  {note.data.date.replaceAll('-', '.')}
                </time>
                <div>
                  <div class="tag-list">
                    {note.data.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <h2>
                    <a href={notePath(note)}>
                      {note.data.title}
                      <ArrowUpRightIcon size={21} />
                    </a>
                  </h2>
                  <p>{note.data.description}</p>
                </div>
              </article>
            ))}
        </div>
      </section>
    ))}
    <p class="page-postscript">
      {t('刚刚开始，往后慢慢写。', 'A beginning. More pages to come.')}
      <br />
      <a class="text-link" href="/archives/">
        {t('查看 2024 年的早期记录', 'Earlier entries from 2024')} ↗
      </a>
    </p>
  </div>
</Base>
