---
import Base from '../layouts/Base.astro';
import { ArrowUpRightIcon } from '@phosphor-icons/react/ssr';
import { getContent, localeFromPath, translator } from '../data/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const { projects } = getContent(locale);
---

<Base
  title={t('项目', 'Projects')}
  description={t(
    'Kevin 的项目索引：AI 产品、macOS 应用和企业工作流，从想法到实际应用。',
    'Kevin’s project index: AI products, macOS applications, and enterprise workflows, from ideas to working applications.',
  )}
>
  <div class="container page-container">
    <header class="page-heading">
      <div class="eyebrow">{t('写作之外', 'Outside the journal')}</div>
      <h1>{t('让想法，有所着落。', 'Ideas, made real.')}</h1>
      <p>
        {t(
          'AI 产品、macOS 应用和企业工作流。用具体项目，记录想法如何变成软件。',
          'AI products, macOS apps, and business workflows. A collection of ideas turned into working software.',
        )}
      </p>
    </header>
    <div class="project-list">
      {projects.map((project, i) => (
        <a
          class="project-entry"
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="project-number">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2>{project.name}</h2>
            <span class="project-role">{project.role}</span>
          </div>
          <div class="project-description">
            <span class="eyebrow">{project.category}</span>
            <p>{project.description}</p>
          </div>
          <ArrowUpRightIcon size={24} />
        </a>
      ))}
    </div>
  </div>
</Base>
