---
import { getNotes, noteSlug } from '../data/notes';
import {
  ArrowUpRightIcon,
  ArrowRightIcon,
  RssIcon,
  CopyIcon,
} from '@phosphor-icons/react/ssr';
import Base from '../layouts/Base.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import XIcon from '../components/XIcon.astro';
import GardenFeed, { type FeedItem } from '../components/GardenFeed';
import {
  getContent,
  localeFromPath,
  localizedPath,
  translator,
} from '../data/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
const { site, thoughts, bookmarks, projects } = getContent(locale);
const notes = await getNotes(locale);
const selectedProjects = projects.filter((project) =>
  ['valseit', 'avatar', 'flash'].includes(project.id),
);
const items: FeedItem[] = [
  ...notes.map((note) => ({
    id: note.id,
    date: note.data.date,
    title: note.data.title,
    text: note.data.description,
    tag: note.data.tags[0],
    url: href(`/notes/${noteSlug(note)}/`),
    kind: 'note' as const,
  })),
  ...thoughts.map((item) => ({
    ...item,
    title: t('关于这里的一点近况', 'A small note on starting again'),
    kind: 'thought' as const,
  })),
  ...bookmarks.map((item) => ({
    ...item,
    text: item.description,
    tag: item.category,
    kind: 'bookmark' as const,
  })),
].sort((a, b) => b.date.localeCompare(a.date));
---

<Base image="/images/kevin-workbench.png">
  <div class="container home-layout">
    <section class="identity-intro" aria-labelledby="identity-title">
      <div class="identity-heading">
        <h1 id="identity-title">
          Kevin<span>.</span>
        </h1>
        <p class="identity-role">
          {t(
            'AI 产品 · macOS 工具 · 企业 AI 定制',
            'AI products · macOS tools · Custom AI',
          )}
        </p>
      </div>
      <img
        class="identity-art"
        src="/images/kevin-workbench.png"
        alt={t(
          'Kevin 的狐狸形象戴着黑框眼镜、穿着花衬衫，在暖灯下使用笔记本电脑。',
          'Kevin’s fox character in black glasses and a floral shirt, working on a laptop by a warm desk lamp.',
        )}
        width="2172"
        height="724"
        fetchpriority="high"
      />
      <div class="identity-links">
        <a
          href={site.x}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t('Kevin 的 X', 'Kevin on X')}
        >
          <XIcon size={16} />X<ArrowUpRightIcon size={13} />
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t('Kevin 的 GitHub', 'Kevin on GitHub')}
        >
          <GitHubIcon size={18} />
          GitHub
          <ArrowUpRightIcon size={13} />
        </a>
        <a class="identity-about" href={href('/about/')}>
          {t('更多关于我', 'More about me')}
          <ArrowRightIcon size={15} />
        </a>
      </div>
    </section>
    <section
      class="journal-stream"
      id="journal-entries"
      aria-labelledby="entries-title"
    >
      <div class="section-label">
        <h2 id="entries-title">
          {t('最近的文章与记录', 'Recent writing & notes')}
        </h2>
        <span>
          {String(items.length).padStart(2, '0')} {t('则记录', 'entries')}
        </span>
      </div>
      <GardenFeed items={items} locale={locale} client:load />
    </section>
    <aside class="journal-sidebar">
      <section class="home-work" aria-labelledby="home-work-title">
        <h2 class="eyebrow" id="home-work-title">
          {t('我的项目', 'Selected projects')}
        </h2>
        <ul>
          {selectedProjects.map((project) => (
            <li>
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                <span
                  class="project-initial"
                  data-project={project.id}
                  aria-hidden="true"
                >
                  {project.name.slice(0, 1).toUpperCase()}
                </span>
                <span class="home-project-name">
                  <strong>{project.name}</strong>
                  <small>{project.role}</small>
                </span>
                <ArrowUpRightIcon size={16} />
              </a>
            </li>
          ))}
        </ul>
        <a class="text-link" href={href('/projects/')}>
          {t('所有项目', 'All projects')}
          <ArrowRightIcon size={15} />
        </a>
      </section>
      <section class="rss-note" aria-labelledby="rss-title">
        <RssIcon size={21} />
        <h2 id="rss-title">
          {t('按自己的节奏阅读。', 'Read at your own pace.')}
        </h2>
        <p>
          {t(
            '新文章会出现在 RSS 里。在你的阅读器中，慢慢看。',
            'New writing, delivered to your feed reader. Nothing to keep up with.',
          )}
        </p>
        <div class="rss-actions">
          <a class="rss-address text-link" href={href('/rss.xml')}>
            {t('订阅 RSS', 'Subscribe via RSS')}
            <ArrowUpRightIcon size={15} />
          </a>
          <button
            type="button"
            data-copy-rss
            data-copy-success={t('订阅地址已复制', 'Feed address copied')}
            data-copy-error={t(
              '暂时无法复制，请打开 RSS 链接获取地址。',
              'Could not copy. Open the RSS link to get the address.',
            )}
            aria-label={t('复制 RSS 订阅地址', 'Copy RSS feed address')}
          >
            <CopyIcon size={17} />
          </button>
        </div>
        <p class="copy-status" data-copy-status role="status"></p>
      </section>
    </aside>
  </div>
  <script>
    document
      .querySelector<HTMLButtonElement>('[data-copy-rss]')
      ?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const address =
          document.querySelector<HTMLAnchorElement>('.rss-address')?.href;
        const status =
          document.querySelector<HTMLElement>('[data-copy-status]');
        if (!address || !status) return;
        try {
          await navigator.clipboard.writeText(address);
          status.textContent = button.dataset.copySuccess ?? '';
        } catch {
          status.textContent = button.dataset.copyError ?? '';
        }
      });
  </script>
</Base>
