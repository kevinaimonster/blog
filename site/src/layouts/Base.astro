---
import {
  MoonIcon as Moon,
  SunIcon as Sun,
  ListIcon as List,
  XIcon as X,
} from '@phosphor-icons/react/ssr';
import {
  getContent,
  localeFromPath,
  localizedPath,
  translator,
  withoutLocale,
} from '../data/i18n';
import '@fontsource-variable/manrope';
import '../styles/journal.css';
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const pathname = Astro.url.pathname;
const locale = localeFromPath(pathname);
const { site, navigation } = getContent(locale);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
const {
  title,
  description = site.description,
  image = site.avatar,
} = Astro.props;
const currentPath = withoutLocale(pathname);
const isHome = currentPath === '/';
const isActive = (href: string) =>
  href === '/' ? isHome : currentPath.startsWith(href);
const canonical = new URL(pathname, Astro.site);
const alternatePath = /^\/404(?:\.html|\/)?$/.test(currentPath)
  ? '/'
  : currentPath;
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Kevin` : site.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101f2d" />
    <meta
      property="og:title"
      content={title ? `${title} · Kevin` : site.title}
    />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta
      name="twitter:card"
      content={image === site.avatar ? 'summary' : 'summary_large_image'}
    />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(localizedPath(alternatePath, 'en'), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="zh-CN"
      href={new URL(localizedPath(alternatePath, 'zh'), Astro.site)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t('Kevin 的笔记', 'Kevin’s notes')}
      href={href('/rss.xml')}
    />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('garden-theme') === 'light' ? 'light' : 'dark';
        if (
          location.pathname === '/' &&
          localStorage.getItem('garden-language') === 'zh'
        ) {
          location.replace('/zh/' + location.search + location.hash);
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('跳到正文', 'Skip to content')}
    </a>
    <header
      class:list={['site-header', 'container', { 'home-header': isHome }]}
    >
      <a
        class="wordmark"
        href={href('/')}
        aria-label={t('Kevin 的个人博客首页', 'Kevin’s personal blog home')}
      >
        <span class="wordmark-symbol">
          k<span>.</span>
        </span>
        <span class="wordmark-caption">
          Kevin<small>{t('个人手记', 'A personal journal')}</small>
        </span>
      </a>
      <nav aria-label={t('主导航', 'Main navigation')} class="main-nav">
        {navigation.map((item) => (
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="header-tools">
        <button
          type="button"
          class="mobile-menu-button"
          aria-expanded="false"
          aria-controls="mobile-navigation"
          data-menu-toggle
        >
          {t('菜单', 'Menu')} <List size={18} aria-hidden="true" />
        </button>
        <a
          class="language-toggle"
          href={localizedPath(alternatePath, locale === 'en' ? 'zh' : 'en')}
          lang={locale === 'en' ? 'zh-CN' : 'en'}
          hreflang={locale === 'en' ? 'zh-CN' : 'en'}
          aria-label={t('Switch to English', '切换到中文')}
          data-language-toggle={locale === 'en' ? 'zh' : 'en'}
        >
          {t('EN', '中文')}
        </a>
        <button
          class="theme-toggle"
          type="button"
          aria-label={t('切换到浅色模式', 'Switch to light mode')}
          data-theme-toggle
        >
          <Sun size={22} className="sun-icon" aria-hidden="true" />
          <Moon size={22} className="moon-icon" aria-hidden="true" />
        </button>
      </div>
      <dialog
        id="mobile-navigation"
        class="mobile-navigation"
        aria-label={t('手机导航', 'Mobile navigation')}
      >
        <div class="mobile-menu-heading">
          <span>Kevin</span>
          <button
            type="button"
            data-menu-close
            aria-label={t('关闭菜单', 'Close menu')}
          >
            <X size={24} />
          </button>
        </div>
        <nav aria-label={t('手机导航', 'Mobile navigation')}>
          {navigation.map((item) => (
            <a
              href={href(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </dialog>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <div class="footer-top">
        <div>
          <a class="footer-name" href={href('/')}>
            Kevin<span>.</span>
          </a>
          <p>
            {t(
              '写下一些事，再慢慢想明白。',
              'A few things written down. A few things figured out.',
            )}
          </p>
        </div>
        <a class="text-link" href={href('/rss.xml')}>
          RSS ↗
        </a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Kevin</span>
        <div>
          <a href={site.x} target="_blank" rel="noopener noreferrer">
            X ↗
          </a>
          <a href={site.github} target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
          <a href={href('/about/')}>
            {t('关于这个博客', 'About this journal')}
          </a>
        </div>
      </div>
    </footer>
    <script>
      const zh = document.documentElement.lang === 'zh-CN';
      document
        .querySelector<HTMLAnchorElement>('[data-language-toggle]')
        ?.addEventListener('click', (event) => {
          const link = event.currentTarget as HTMLAnchorElement;
          try {
            localStorage.setItem(
              'garden-language',
              link.dataset.languageToggle!,
            );
          } catch {}
        });
      const themeButton = document.querySelector<HTMLButtonElement>(
        '[data-theme-toggle]',
      );
      const syncTheme = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        themeButton?.setAttribute(
          'aria-label',
          zh
            ? dark
              ? '切换到浅色模式'
              : '切换到深色模式'
            : dark
              ? 'Switch to light mode'
              : 'Switch to dark mode',
        );
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#101f2d' : '#f2f7fa');
      };
      syncTheme();
      themeButton?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('garden-theme', next);
        } catch {}
        syncTheme();
      });
      const menuButton =
        document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu =
        document.querySelector<HTMLDialogElement>('#mobile-navigation');
      menuButton?.addEventListener('click', () => {
        menu?.showModal();
        menuButton.setAttribute('aria-expanded', 'true');
      });
      document
        .querySelector('[data-menu-close]')
        ?.addEventListener('click', () => menu?.close());
      menu?.addEventListener('close', () =>
        menuButton?.setAttribute('aria-expanded', 'false'),
      );
    </script>
  </body>
</html>
