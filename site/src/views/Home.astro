---
import { getNotes, noteSlug } from '../data/notes';
import { Rss, BriefcaseBusiness, ArrowRight, Copy } from 'lucide-react';
import Base from '../layouts/Base.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import XIcon from '../components/XIcon.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import GardenFeed, { type FeedItem } from '../components/GardenFeed';
import {
  getContent,
  localeFromPath,
  localizedPath,
  translator,
} from '../data/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
const { site, projects, thoughts, bookmarks, photos } = getContent(locale);
const notes = await getNotes(locale);
const items: FeedItem[] = [
  ...notes.map((note) => ({
    id: note.id,
    date: note.data.date,
    title: note.data.title,
    text: note.data.description,
    tag: note.data.tags[0],
    url: href(`/notes/${noteSlug(note)}/`),
    kind: 'note' as const,
  })),
  ...thoughts.map((item) => ({
    ...item,
    title: t('一条建站近况', 'A small update on this site'),
    kind: 'thought' as const,
  })),
  ...bookmarks.map((item) => ({
    ...item,
    text: item.description,
    tag: item.category,
    kind: 'bookmark' as const,
  })),
].sort((a, b) => b.date.localeCompare(a.date));
---

<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <a
      class="hero-avatar"
      href={href('/about/')}
      aria-label={t('关于 Kevin', 'About Kevin')}
    >
      <img
        src={site.avatar}
        alt={t('Kevin 的头像，来自 kevin.top', 'Kevin’s avatar from kevin.top')}
        width="64"
        height="64"
        fetchpriority="high"
      />
    </a>
    <div class="hero-copy">
      <h1 id="hero-title">
        {site.headline[0]}
        <br />
        {site.headline[1]}
      </h1>
      <p>{site.intro}</p>
      <div class="social-links">
        <a
          href={site.x}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t('Kevin 的 X', 'Kevin on X')}
        >
          <XIcon />
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t('Kevin 的 GitHub', 'Kevin on GitHub')}
        >
          <GitHubIcon />
        </a>
      </div>
    </div>
  </section>
  <section
    class="photo-section"
    aria-label={t(
      '图片带：原站插画与可替换的图库示意图',
      'An illustration from kevin.top and stock photographs',
    )}
  >
    <div class="photo-track">
      {photos.map((photo) => (
        <figure class="photo-frame">
          <img
            src={photo.src}
            alt={photo.alt}
            width="576"
            height="640"
            loading="eager"
          />
          <a
            href={photo.source}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t('查看来源', 'View source')}: ${photo.alt}`}
          >
            <span>
              {photo.kind} · {photo.credit}
            </span>
          </a>
        </figure>
      ))}
    </div>
  </section>
  <div class="journal-grid container">
    <section
      aria-label={t('笔记与近况', 'Notes and updates')}
      class="journal-main"
    >
      <GardenFeed items={items} locale={locale} client:load />
    </section>
    <aside class="journal-aside">
      <section
        class="sidebar-card subscribe-card"
        aria-labelledby="subscribe-title"
      >
        <h2 id="subscribe-title">
          <Rss size={22} aria-hidden="true" />
          {t('保持联系', 'Stay in the loop')}
        </h2>
        <p>
          {t(
            '通过 RSS 查看新笔记，按自己的节奏阅读。',
            'New notes via RSS. Read them at your own pace.',
          )}
        </p>
        <div class="rss-controls">
          <a href={href('/rss.xml')} class="rss-address">
            {t('Kevin 的笔记 · RSS', 'Kevin’s notes · RSS')}
          </a>
          <button
            type="button"
            data-copy-rss
            data-copy-success={t('订阅地址已复制', 'Feed address copied')}
            data-copy-error={t(
              '暂时无法复制，可以打开左侧 RSS 链接获取地址。',
              'Could not copy. Open the RSS link to get the address.',
            )}
            aria-label={t('复制 RSS 订阅地址', 'Copy RSS feed address')}
          >
            <Copy size={15} aria-hidden="true" />
            {t('复制', 'Copy')}
          </button>
        </div>
        <span class="copy-status" role="status" data-copy-status></span>
      </section>
      <section class="sidebar-card work-card" aria-labelledby="work-title">
        <h2 id="work-title">
          <BriefcaseBusiness size={22} aria-hidden="true" />
          {t('作品与项目', 'Selected work')}
        </h2>
        <ul>
          {projects
            .filter((project) => project.featured)
            .map((project) => (
              <li>
                <ProjectIcon icon={project.icon} size={21} />
                <div>
                  <a
                    href={project.url}
                    target={
                      project.url.startsWith('http') ? '_blank' : undefined
                    }
                    rel={
                      project.url.startsWith('http')
                        ? 'noopener noreferrer'
                        : undefined
                    }
                  >
                    {project.name}
                  </a>
                  <div class="project-meta">
                    <span>{project.role}</span>
                    <span>{project.category}</span>
                  </div>
                </div>
              </li>
            ))}
        </ul>
        <a class="subtle-button" href={href('/projects/')}>
          {t('查看所有项目', 'View all projects')} <ArrowRight size={15} />
        </a>
      </section>
    </aside>
  </div>
  <script>
    const button = document.querySelector<HTMLButtonElement>('[data-copy-rss]');
    button?.addEventListener('click', async () => {
      const status = document.querySelector<HTMLElement>('[data-copy-status]');
      try {
        await navigator.clipboard.writeText(
          document.querySelector<HTMLAnchorElement>('.rss-address')!.href,
        );
        if (status) status.textContent = button.dataset.copySuccess!;
      } catch {
        if (status) status.textContent = button.dataset.copyError!;
      }
    });
  </script>
</Base>
