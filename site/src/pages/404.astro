---
import Base from '../layouts/Base.astro';
import { ArrowLeftIcon as ArrowLeft } from '@phosphor-icons/react/ssr';
---

<Base
  title="Page not found"
  description="This page could not be found. Return to Kevin’s personal blog to keep reading."
  noindex
  alternates={[]}
  canonicalPath="/404.html"
>
  <div class="container not-found">
    <div class="eyebrow">404 / NOT FOUND</div>
    <h1>This page isn’t here.</h1>
    <p>The link may have changed. Return to the journal to keep reading.</p>
    <a class="text-link" href="/">
      <ArrowLeft size={16} /> Back to the journal
    </a>
  </div>
</Base>
