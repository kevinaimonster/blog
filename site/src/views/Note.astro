---
import { render, type CollectionEntry } from 'astro:content';
import { localeFromPath, localizedPath, translator } from '../data/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);

import { ArrowLeft, ArrowRight } from 'lucide-react';
import Base from '../layouts/Base.astro';
interface Props {
  note: CollectionEntry<'notes'>;
}
const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={note.data.title} description={note.data.description}>
  <article class="article-page container">
    <a class="quiet-link back-link" href={href('/notes/')}>
      <ArrowLeft size={15} /> {t('所有笔记', 'All notes')}
    </a>
    <header class="article-heading">
      <div class="article-meta">
        <time datetime={note.data.date}>
          {note.data.date.replaceAll('-', '.')}
        </time>
        <span>·</span>
        <span>Kevin</span>
      </div>
      <h1>{note.data.title}</h1>
      <p>{note.data.description}</p>
      <div class="tag-list">
        {note.data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <div class="article-bottom">
      <span>
        {t('写下此刻，也为以后的想法留白。', 'Written now, with room to grow.')}
      </span>
      <a class="text-link" href={href('/')}>
        {t('回到花园', 'Back to the garden')} <ArrowRight size={15} />
      </a>
    </div>
  </article>
</Base>
