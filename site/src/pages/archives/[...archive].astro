---
import Base from '../../layouts/Base.astro';
import { getPublishedNotes, notePath } from '../../data/notes';

export function getStaticPaths() {
  return [undefined, '2024', '2024/06'].map((archive) => ({
    params: { archive },
  }));
}
const notes = (await getPublishedNotes('en')).filter(
  (note) => note.data.archived,
);
---

<Base
  title="Earlier entries"
  description="The first two entries from Kevin’s original blog, preserved at their original addresses."
  noindex
  alternates={[]}
  canonicalPath="/archives/"
>
  <div class="container page-container">
    <header class="page-heading">
      <div class="eyebrow">From the archive · 2024</div>
      <h1>Earlier entries.</h1>
      <p>
        The first two records from the original blog. Their addresses still
        work.
      </p>
    </header>
    <div class="notes-list">
      {notes.map((note) => (
        <article>
          <time datetime={note.data.date}>{note.data.date}</time>
          <div>
            <h2>
              <a href={notePath(note)}>{note.data.title} ↗</a>
            </h2>
            <p>{note.data.description}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="page-postscript">
      <a class="text-link" href="/notes/">
        Back to current writing ↗
      </a>
    </p>
  </div>
</Base>
