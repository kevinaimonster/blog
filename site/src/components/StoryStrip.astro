---
import WorkVisual from './WorkVisual.astro';
import { getContent, translator, type Locale } from '../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { photos, projects } = getContent(locale);
const t = translator(locale);
const frames = [
  { photo: photos[0] },
  { project: projects.find((item) => item.id === 'second-me')! },
  { photo: photos[2] },
  { project: projects.find((item) => item.id === 'avatar')! },
  { photo: photos[3] },
];
---

<section
  class="photo-section"
  aria-label={t('作品、插画与风景', 'Work, illustration, and a little scenery')}
>
  <div
    class="photo-scroll"
    tabindex="0"
    aria-label={t(
      '横向浏览作品与图片',
      'Browse projects and images horizontally',
    )}
  >
    <div class="photo-track">
      {frames.map((frame) => (
        <figure
          class:list={['photo-frame', { 'project-frame': !!frame.project }]}
        >
          {frame.project ? (
            <>
              <WorkVisual id={frame.project.id} locale={locale} />
              <a
                class="project-frame-link"
                href={frame.project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${frame.project.name}: ${frame.project.description}`}
              >
                <span class="sr-only">{frame.project.name}</span>
              </a>
            </>
          ) : (
            frame.photo && (
              <>
                <img
                  src={frame.photo.src}
                  alt={frame.photo.alt}
                  width="576"
                  height="640"
                  loading="eager"
                />
                <a
                  href={frame.photo.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t('查看来源', 'View source')}: ${frame.photo.alt}`}
                >
                  <span>
                    {frame.photo.kind} · {frame.photo.credit}
                  </span>
                </a>
              </>
            )
          )}
        </figure>
      ))}
    </div>
  </div>
  <p class="strip-caption container">
    <span>{t('作品与日常', 'Work & everything in between')}</span>
    <span>01 — 05</span>
  </p>
</section>
