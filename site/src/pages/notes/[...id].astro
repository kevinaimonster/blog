---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowRight } from 'lucide-react';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={note.data.title} description={note.data.description}>
  <article class="article-page container">
    <a class="quiet-link back-link" href="/notes/">
      <ArrowLeft size={15} /> 所有笔记
    </a>
    <header class="article-heading">
      <div class="article-meta">
        <time datetime={note.data.date}>
          {note.data.date.replaceAll('-', '.')}
        </time>
        <span>·</span>
        <span>Kevin</span>
      </div>
      <h1>{note.data.title}</h1>
      <p>{note.data.description}</p>
      <div class="tag-list">
        {note.data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <div class="article-bottom">
      <span>写下此刻，也为以后的想法留白。</span>
      <a class="text-link" href="/">
        回到花园 <ArrowRight size={15} />
      </a>
    </div>
  </article>
</Base>
