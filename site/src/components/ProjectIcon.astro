---
import {
  BrainIcon as Brain,
  GraphIcon as Network,
  SquaresFourIcon as PanelsTopLeft,
  StackIcon as Layers,
  LightningIcon as Zap,
} from '@phosphor-icons/react/ssr';
interface Props {
  icon: string;
  size?: number;
}
const { icon, size = 22 } = Astro.props;
const icons = {
  brain: Brain,
  network: Network,
  canvas: PanelsTopLeft,
  layers: Layers,
  zap: Zap,
};
const Icon = icons[icon as keyof typeof icons] || Layers;
---

<span class:list={['project-icon', `project-icon-${icon}`]}>
  <Icon size={size} aria-hidden="true" />
</span>
