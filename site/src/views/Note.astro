---
import { render, type CollectionEntry } from 'astro:content';
import { localeFromPath, localizedPath, translator } from '../data/i18n';
import { ArrowLeftIcon, ArrowRightIcon } from '@phosphor-icons/react/ssr';
import Base from '../layouts/Base.astro';
interface Props {
  note: CollectionEntry<'notes'>;
}
const { note } = Astro.props;
const { Content, headings } = await render(note);
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---

<Base title={note.data.title} description={note.data.description}>
  <article class="article-page container">
    <a class="quiet-link back-link" href={href('/notes/')}>
      <ArrowLeftIcon size={15} />
      {t('所有文章', 'All writing')}
    </a>
    <header class="article-heading">
      <div class="article-meta">
        <time datetime={note.data.date}>
          {note.data.date.replaceAll('-', '.')}
        </time>
        <span>—</span>
        <span>Kevin Bao</span>
      </div>
      <h1>{note.data.title}</h1>
      <p>{note.data.description}</p>
      <div class="tag-list">
        {note.data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>
    <div class="article-divider"></div>
    <div class="article-layout">
      <aside class="article-toc">
        <p class="eyebrow">{t('这篇文章', 'In this entry')}</p>
        <nav aria-label={t('文章目录', 'Table of contents')}>
          {headings
            .filter((heading) => heading.depth === 2)
            .map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
        </nav>
      </aside>
      <div class="prose">
        <Content />
      </div>
      <div class="article-bottom">
        <span>
          {t(
            '写下此刻，也为以后的想法留白。',
            'Written now, with room to grow.',
          )}
        </span>
        <a class="text-link" href={href('/notes/')}>
          {t('回到文章归档', 'Back to the archive')}
          <ArrowRightIcon size={15} />
        </a>
      </div>
    </div>
  </article>
</Base>
