---
import { ArrowUpRight } from 'lucide-react';
import GitHubIcon from '../components/GitHubIcon.astro';
import XIcon from '../components/XIcon.astro';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="关于">
  <div class="container page-container about-page">
    <header class="page-heading">
      <div class="eyebrow">A LITTLE ABOUT ME</div>
      <h1>
        你好，我是 Kevin<span class="accent-period">.</span>
      </h1>
      <p>独立做 AI 产品，也做企业 AI 定制。</p>
    </header>
    <div class="about-layout">
      <div class="prose">
        {site.about.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <h2>在这里，你会看到</h2>
        <ul>
          <li>
            <strong>近况</strong>：短一点的记录，还没想完也没关系。
          </li>
          <li>
            <strong>笔记</strong>：完整一点的思考与过程。
          </li>
          <li>
            <strong>收藏</strong>：值得再次回来的链接。
          </li>
          <li>
            <strong>项目</strong>：正在做的作品，以及它们的进展。
          </li>
        </ul>
        <h2>关于这个网站</h2>
        <p>
          这个网站以 Spotlight
          为视觉参考，使用独立编写的代码实现。内容会持续补充，结构也会随着使用慢慢调整。
        </p>
        <p>
          头像、海滩插画和个人资料沿用自{' '}
          <a href="https://kevin.top/">kevin.top</a>。 图片带中的其余图片来自
          Unsplash 图库，不代表个人摄影或旅行经历；点击图片可查看来源。
        </p>
      </div>
      <aside class="about-links">
        <span class="eyebrow">ELSEWHERE</span>
        <a href={site.x} target="_blank" rel="noopener noreferrer">
          <XIcon size={18} />
          <span>
            X<small>@KevinAIMonster</small>
          </span>
          <ArrowUpRight size={16} />
        </a>
        <a href={site.github} target="_blank" rel="noopener noreferrer">
          <GitHubIcon size={18} />
          <span>
            GitHub<small>@kevinaimonster</small>
          </span>
          <ArrowUpRight size={16} />
        </a>
      </aside>
    </div>
  </div>
</Base>
