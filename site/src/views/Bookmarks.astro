---
import { ArrowUpRightIcon } from '@phosphor-icons/react/ssr';
import Base from '../layouts/Base.astro';
import { getContent, localeFromPath, translator } from '../data/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const { bookmarks } = getContent(locale);
---

<Base title={t('收藏', 'Bookmarks')}>
  <div class="container page-container">
    <header class="page-heading">
      <div class="eyebrow">{t('留在书架上的', 'Kept on the shelf')}</div>
      <h1>{t('值得，再看一次。', 'Worth another look.')}</h1>
      <p>
        {t(
          '留下一个链接，也留下当时收藏它的理由。',
          'A collection of links, with a reason to return to each one.',
        )}
      </p>
    </header>
    <div class="bookmark-list">
      {bookmarks.map((bookmark, i) => (
        <a
          class="bookmark-card"
          href={bookmark.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="bookmark-number">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <span class="eyebrow">{bookmark.category}</span>
            <h2>{bookmark.title}</h2>
            <p>{bookmark.description}</p>
            <span class="bookmark-domain">{bookmark.domain}</span>
          </div>
          <ArrowUpRightIcon size={26} />
        </a>
      ))}
    </div>
    <p class="page-postscript">
      {t(
        '收藏不在于多。能让自己再次停下来的，就值得留下。',
        'A small collection is enough. Keep what makes you pause.',
      )}
    </p>
  </div>
</Base>
